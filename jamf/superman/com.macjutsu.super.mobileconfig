<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  S.U.P.E.R.M.A.N. (super) configuration profile
  Purpose: Enforce macOS 26.6.2 on out-of-date Macs — a minor update for Macs
           already on 26.x, and a major upgrade for Macs on 14/15.
  Preference domain: com.macjutsu.super

  BEFORE DEPLOYING:
    1. Set PayloadOrganization to your org name (only REPLACE_ME left in the file).
    2. Do NOT put the Jamf API client id/secret here — those go in the Jamf policy
       Script Parameters (they would otherwise be visible to local users).
    3. $JSSID and $MANAGEMENTID are Jamf Pro configuration-profile variables that Jamf
       substitutes per-computer at deployment time. Leave them exactly as written.
    4. Enforcement is 8 deferrals 1 hour apart (DeadlineCountHard + DeferralTimerDefault);
       adjust those two integers if you want a different count/interval.

  This can be deployed as-is (it is a complete .mobileconfig) or the inner <dict> can be
  pasted into a new "Application & Custom Settings" payload with domain com.macjutsu.super.
-->
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>com.macjutsu.super</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadIdentifier</key>
			<string>com.macjutsu.super.D4A6E2CF-F389-4207-A459-CDE9EA219E9E</string>
			<key>PayloadUUID</key>
			<string>D4A6E2CF-F389-4207-A459-CDE9EA219E9E</string>
			<key>PayloadDisplayName</key>
			<string>super settings</string>
			<key>PayloadEnabled</key>
			<true/>

			<!-- ============================================================
			     TARGET: macOS 26.

			     !! DO NOT put a full 3-part version here (e.g. 26.6.2) !!

			     Despite the wording in super's docs, these target keys are matched
			     with EXACT EQUALITY in super 5.1.1, not "this version or older":

			       0 dots ("26")      -> compares MAJOR only        (matches any 26.x)
			       1 dot  ("26.6")    -> compares MAJOR.MINOR
			       2 dots ("26.6.2")  -> compares MAJOR.MINOR.PATCH (exact build only)

			     With "26.6.2" set, super rejects whatever Apple is actually offering
			     unless it is precisely 26.6.2, logs "Unable to target the latest
			     available over-the-air macOS major upgrade", ends with no target, and
			     reports "Full super workflow complete!" having done nothing.

			     "26" lets super install whatever macOS 26 release Apple is serving,
			     while still never jumping the fleet to macOS 27.
			     ============================================================ -->

			<!-- Permit major upgrades at all (without this, 14/15 Macs stay put). -->
			<key>InstallMacOSMajorUpgrades</key>
			<true/>

			<!-- MAJOR upgrade destination: any macOS 26, never 27. -->
			<key>InstallMacOSMajorVersionTarget</key>
			<string>26</string>

			<!-- NOTE: InstallMacOSMinorVersionTarget is deliberately NOT set.
			     Setting it to 26.6.2 made super reject any minor update that was not
			     exactly 26.6.2 (including the 14.8.5 offered to Macs still on 14.x),
			     leaving them with no target at all. Unset = install the latest
			     available minor update, which is what "get everyone current" means. -->

			<!-- ============================================================
			     Deferrals: allow 8 deferrals, 1 hour apart = an 8-hour window.
			       DeferralTimerDefault = 60  -> each "Later" waits 60 minutes.
			       DeadlineCountHard    = 8   -> after the 8th deferral, the Mac
			                                     installs and restarts WITHOUT asking
			                                     (the user gets a restart notice).
			     Simple by design: no focus/soft counts, no calendar dates.
			     ============================================================ -->
			<key>DeferralTimerDefault</key>
			<integer>60</integer>
			<key>DeadlineCountHard</key>
			<integer>8</integer>

			<!-- ============================================================
			     AUTH METHOD: saved local account, passed via the Jamf policy as
			     auth-local-account / auth-local-password Script Parameters.
			     Validated and stored in the System keychain on first run, then used
			     silently. Works on every macOS version with no Jamf API involved,
			     so it sidesteps the macOS 14 Management ID bug entirely.

			     Deliberately NOT setting AuthAskUserToSavePassword here: super allows
			     only one Apple silicon auth method and the user-password option
			     OUTRANKS the local account, so setting it would make super delete the
			     saved local-account credentials and start prompting users instead.
			     ============================================================ -->

			<!-- ============================================================
			     Apple silicon MDM enforcement. These two identifiers let super
			     send the managed-update MDM command via the Jamf Pro API.
			     Jamf substitutes the values per-computer; leave the $variables as-is.
			     ============================================================ -->
			<key>AuthJamfComputerID</key>
			<string>$JSSID</string>
			<key>AuthJamfManagementID</key>
			<string>$MANAGEMENTID</string>

			<!-- ============================================================
			     Two DIFFERENT failovers — keep both:
			       AuthCredentialFailoverToUser: if the Jamf API client/secret
			         cannot be VALIDATED, prompt the logged-in user to authenticate
			         instead of dead-ending. This is the one that prevents the
			         "authentication options could not be validated and no failover
			         option was specified" hard stop.
			       AuthMDMFailoverToUser: if the MDM push workflow fails AFTER the
			         credentials validated, fall back to user auth so the install
			         still proceeds.
			     ============================================================ -->
			<key>AuthCredentialFailoverToUser</key>
			<true/>
			<key>AuthMDMFailoverToUser</key>
			<string>ALWAYS</string>

			<!-- ============================================================
			     Optional: branding shown in the update dialogs.
			     ============================================================ -->
			<key>DisplayIconFile</key>
			<string>/Applications/Self Service.app/Contents/Resources/AppIcon.icns</string>
		</dict>
	</array>
	<key>PayloadDisplayName</key>
	<string>super — Enforce macOS 26.6.2</string>
	<key>PayloadIdentifier</key>
	<string>com.macjutsu.super.enforce-26-6-2.2560FAAB-5EC2-4415-82CA-45E8959EC937</string>
	<key>PayloadOrganization</key>
	<string>REPLACE_ME Organization</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>2560FAAB-5EC2-4415-82CA-45E8959EC937</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
